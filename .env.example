# Copy to `.env` at the repo root and fill in your Supabase project values.
# Use the ANON public key (Dashboard → Project Settings → API → "anon public").
# NEVER use the service_role key in a frontend app — it bypasses Row Level Security.
SUPABASEURL=https://your-project.supabase.co
SUPABASEKEY=your-anon-public-key
